<?xml version="1.0" encoding="UTF-8"?>
<!-- Evita que HikariCP llene la consola con mensajes DEBUG/INFO al ejecutar los main (PrepararDatos, VerificarTP, etc.) -->
<configuration>
	<appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
		</encoder>
	</appender>
	<root level="WARN">
		<appender-ref ref="CONSOLA"/>
	</root>
</configuration>
